pragma solidity 0.8.26;

import {PoolKey} from "@uniswap/v4-core/src/types/PoolKey.sol";
import {Currency} from "@uniswap/v4-core/src/types/Currency.sol";
import {IHooks} from "@uniswap/v4-core/src/interfaces/IHooks.sol";
import {IUniversalRouter, URSwaps} from "./fork/UniversalRouter.t.sol";

/// The exact bytes of the site's swap box (web/app/trade/swap.ts): the router call the fork suite proves on mainnet
/// (test/fork/UniversalRouter.t.sol `_urInputs`), for one buy and one sell on a fixed pool key. web/test/swap.test.mjs
/// reads BUY and SELL from this file and requires its own encoder to produce them byte for byte.
contract URCalldataTest is URSwaps {
    address constant TOKEN = 0x1111111111111111111111111111111111111111;
    address constant HOOK = 0x2222222222222222222222222222222222223fFf;
    uint256 constant DEADLINE = 1_800_000_000;

    bytes constant BUY =
        hex"";
    bytes constant SELL =
        hex"";

    function _key() internal pure returns (PoolKey memory) {
        return PoolKey(Currency.wrap(address(0)), Currency.wrap(TOKEN), 0x800000, 1, IHooks(HOOK));
    }

    function _call(bool buy, uint256 amountIn, uint256 minOut) internal pure returns (bytes memory) {
        (bytes memory commands, bytes[] memory inputs) = _urInputs(_key(), buy, amountIn, minOut);
        return abi.encodeCall(IUniversalRouter.execute, (commands, inputs, DEADLINE));
    }

    function test_siteBuy() public pure {
        assertEq(_call(true, 0.1 ether, 380_000e18), BUY);
    }

    function test_siteSell() public pure {
        assertEq(_call(false, 1_000_000e18, 0.25 ether), SELL);
    }
}
