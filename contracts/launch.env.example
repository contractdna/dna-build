# Launch inputs. Copy to contracts/.env.launch (gitignored), fill in every value, then `set -a; . contracts/.env.launch;
# set +a`. None of these is a code default: the launch scripts read them from the environment only.

# The Safe (Ethereum, v1.5.0, 2-of-3). Baked into every post-launch init code.
SAFE=
# The Safe's 3 owners (signers S1, S2, S3), comma-separated, plus any other team wallet to keep out of the holder
# jackpot. Route A checks on chain, at pack time, that every Safe owner is in this list (requireExcluded).
EXCLUDED_WALLETS=
# Agent and anchor key addresses (registry constructor). The private keys never live in this repo.
AGENT=
ANCHOR_KEY=
# Keeper: no on-chain role (funding and the H1 executes only); not read by the launch scripts.
KEEPER=
# The launch wallet (route A): owns the Programmable API key and sends the launch through the wallet handoff. Every
# CREATE2 address depends on it (the packer's namespace).
LAUNCH_WALLET=
# Initial buy (0.5 ETH is the script default), burned in full; the launch wallet must hold it + LAUNCH_GAS_MARGIN_WEI.
INITIAL_BUY_WEI=500000000000000000
LAUNCH_GAS_MARGIN_WEI=30000000000000000
# Must equal DNAToken.X_HANDLE: an explicit confirmation that the frozen tokenURI handle is final.
X_HANDLE_CONFIRMED=
# The public source of the launch package (route A's source.publicOrigin): the project's organisation repo.
PUBLIC_ORIGIN=https://github.com/contractdna/dna-contracts
