# Engine environment: names only. Copy to engine/.env (gitignored) and run with `node --env-file=.env src/engine.ts`.
# Tuning knobs (timings, gates, caps, intervals) have safe defaults in src/config.ts and src/policy.ts.
# In the enclave build only src/enclave.ts ALLOWED_ENVS (secrets) and LITERAL_ENVS (hashed compose literals) are accepted.

# chain + database
DATABASE_URL=
RPC_URL=
ALCHEMY_KEY=
DRPC_KEY=
CHAIN_ID=
DEPLOYMENT_FILE=

# mode: dry_run | live | halted
ENGINE_MODE=
ENGINE_PRELAUNCH=

# keys (local / non-enclave runs; the enclave derives its agent, anchor and log keys inside the TEE)
AGENT_PRIVATE_KEY=
ANCHOR_PRIVATE_KEY=
KEEPER_PRIVATE_KEY=
LOG_SIGNING_KEY=
SECRET_SEAL_KEY=

# models: every call through OpenRouter (pinned to the model's own provider) except server-side search (web/X), which uses xAI direct
OPENROUTER_API_KEY_ENGINE=
XAI_API_KEY=
LLM_DAILY_USD_CAP=
# spend schedule and caps (defaults in src/config.ts; docs/MODELS.md)
LLM_LAUNCH_AT=
LLM_WEEK1_DAILY_USD_CAP=
LLM_MONTHLY_USD_CAP=

# operator channel (restrict-only commands)
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_ALLOWED_USER_IDS=

# persona (src/persona.ts): DNA_PERSONA = base64 of the private persona file (required in the enclave), or locally a
# path in PERSONA_FILE; with neither, a neutral default runs and records personaSha256 null
DNA_PERSONA=
PERSONA_FILE=

# X (OAuth 2.0 user context)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_USER_ID=

# post media: the studio runs outside the enclave and alone holds the image-model key
STUDIO_URL=
STUDIO_TOKEN=
OPENAI_API_KEY=
# optional: images and their rubric through OpenRouter (moderation stays on OPENAI_API_KEY)
STUDIO_VIA=
OPENROUTER_API_KEY_STUDIO=

# policy thresholds (commit-reveal: POLICY_THRESHOLDS must hash to POLICY_THRESHOLDS_SHA256)
POLICY_THRESHOLDS=
POLICY_THRESHOLDS_SHA256=

# public log links
LOG_BASE_URL=
