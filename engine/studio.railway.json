{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "watchPatterns": ["engine/src/studio.ts", "engine/src/media-slots.ts", "engine/src/enclave.ts", "engine/media/references/**", "engine/package-lock.json"] },
  "deploy": {
    "startCommand": "node src/studio.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
