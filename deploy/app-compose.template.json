{
  "manifest_version": 2,
  "name": "dna-engine",
  "runner": "docker-compose",
  "docker_compose_file": "{{DOCKER_COMPOSE}}",
  "kms_enabled": true,
  "local_key_provider_enabled": false,
  "features": ["kms", "tproxy-net"],
  "tproxy_enabled": true,
  "gateway_enabled": true,
  "public_logs": false,
  "public_sysinfo": true,
  "public_tcbinfo": true,
  "allowed_envs": [
    "DATABASE_URL",
    "ALCHEMY_KEY",
    "DRPC_KEY",
    "XAI_API_KEY",
    "OPENROUTER_API_KEY_ENGINE",
    "KEEPER_PRIVATE_KEY",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_GROUP_ID",
    "TELEGRAM_ALLOWED_USER_IDS",
    "X_CLIENT_SECRET",
    "X_REFRESH_TOKEN",
    "ENGINE_MODE",
    "POLICY_THRESHOLDS",
    "STUDIO_TOKEN",
    "GITHUB_TOKEN",
    "DNA_PERSONA"
  ],
  "no_instance_id": false,
  "secure_time": true,
  "storage_fs": "ext4",
  "pre_launch_script": "#!/bin/bash\n# DNA: a no-op on purpose. A non-empty script keeps the provider's default one out of the measured app-compose.\n# Nothing to log in to (the images are public, pinned by digest; compose up pulls them), no root password, no remote shell.\ntrue\n"
}
